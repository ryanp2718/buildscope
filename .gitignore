.venv/
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# ---------------------------------------------------------------------------
# Run artifacts
# ---------------------------------------------------------------------------
.drift_pool.log
*.log

# ---------------------------------------------------------------------------
# Editor and OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Secrets. The API key lives at ~/.anthropic_key, outside the tree, on
# purpose. These patterns are belt and braces.
# ---------------------------------------------------------------------------
.env
.env.*
*.key
.anthropic_key
.permits-contact

# Local agent settings (per-machine permissions, not project config).
.claude/settings.local.json
